%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 957efc90c95f4ad9ab0e56b3c02b4f02, type: 3}
  m_Name: TutorialStory
  m_EditorClassIdentifier:
  openingTitle: "게임 속 이상 현상"
  openingBackground: {fileID: 0}
  opening:
  - speaker: "루루"
    text: "…이상하네. 평소에 하던 리듬게임이랑 화면이 달라."
    expression: 2
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    hideLeft: 0
    hideRight: 0
    background: {fileID: 0}
    sound: {fileID: 0}
  - speaker: "피노"
    text: "루루! 게임 안에 바이러스 반응이 있어! 조심해야겠어."
    expression: 0
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    hideLeft: 0
    hideRight: 0
    background: {fileID: 0}
    sound: {fileID: 0}
  - speaker: "루루"
    text: "…피노, 괜찮아? 너도 저 안에서 움직일 수 있어?"
    expression: 0
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    hideLeft: 0
    hideRight: 0
    background: {fileID: 0}
    sound: {fileID: 0}
  - speaker: "피노"
    text: "응! 마우스를 움직이면 내가 따라가. 먼저 같이 연습해 보자."
    expression: 3
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    hideLeft: 0
    hideRight: 0
    background: {fileID: 0}
    sound: {fileID: 0}
  - speaker: "루루"
    text: "저 원은… 노트에 가까워질수록 겹치는 것 같아."
    expression: 1
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    hideLeft: 0
    hideRight: 0
    background: {fileID: 0}
    sound: {fileID: 0}
  - speaker: "피노"
    text: "맞아! 원이 겹칠 때 눌러 줘. L은 왼쪽, R은 오른쪽 클릭이야."
    expression: 1
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    hideLeft: 0
    hideRight: 0
    background: {fileID: 0}
    sound: {fileID: 0}
  - speaker: "루루"
    text: "…W는 휠이고, 빨간 공격은 피해 가면서 연주하면 되는 거네."
    expression: 1
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    hideLeft: 0
    hideRight: 0
    background: {fileID: 0}
    sound: {fileID: 0}
  - speaker: "피노"
    text: "정답! 준비됐으면 연습을 시작하자. 내가 옆에서 알려 줄게!"
    expression: 2
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    hideLeft: 0
    hideRight: 0
    background: {fileID: 0}
    sound: {fileID: 0}
  closing:
  - speaker: "루루"
    text: "…응. 이제 어떻게 움직이고 연주하는지 알겠어."
    expression: -1
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    hideLeft: 0
    hideRight: 0
    background: {fileID: 0}
    sound: {fileID: 0}
  - speaker: "피노"
    text: "잘했어! 곡을 고르러 가자. 다시 익히고 싶으면 연습도 할 수 있어."
    expression: -1
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    hideLeft: 0
    hideRight: 0
    background: {fileID: 0}
    sound: {fileID: 0}
  incompleteClosing: "…완벽하진 않았지만, 여기까지 해냈어. 다시 연습할 수도 있겠지."
  chapterNames:
  - "피노 움직이기"
  - "왼쪽 클릭"
  - "오른쪽 클릭"
  - "마우스 휠"
  - "탄막 피하기"
  - "실전 연습"
  chapterGuides:
  - "마우스를 움직이면 피노가 따라와."
  - "L 노트의 두 원이 겹치면 왼쪽 클릭!"
  - "R 노트의 두 원이 겹치면 오른쪽 클릭!"
  - "W 노트는 휠을 돌려 시작해. 끝날 때까지 계속 돌려 줘."
  - "붉은 탄막은 피해야 해. 마우스를 움직여 봐."
  - "노트를 맞히면서 붉은 탄막도 피해 봐."
  chapterSuccess:
  - "피노가 움직였어! 이제 손에 익었지?"
  - "좋아! 왼쪽 클릭 타이밍을 잡았어."
  - "맞았어! 오른쪽 클릭도 잘했어."
  - "휠 노트도 해냈어!"
  - "무사히 피해냈어. 계속 가 보자!"
  - "연주와 회피를 함께 해냈어!"
  chapterLead:
  - "마우스를 움직이면 피노가 따라와. 먼저 가볍게 움직여 보자."
  - "이번에는 L 노트야. 원이 겹치는 순간 왼쪽 클릭!"
  - "R 노트는 오른쪽 클릭이야. 앞에서 배운 박자를 기억해."
  - "이번엔 W 노트. 휠을 돌려 시작하고 끝까지 돌려 줘."
  - "빨간 건 노트가 아니야. 피노를 움직여 탄막을 피해!"
  - "마지막이야. 노트 판정과 탄막 회피를 함께 해 보자."
  checkpointFailure: "조금 놓쳐도 괜찮아. 다음 곡에서 다시 시도할 수 있어."
